# 复制本文件为 .aliyun.env 并填写（不要提交 .aliyun.env）

# 阿里云 AccessKey（控制台 → AccessKey 管理 → 创建）
# 建议使用 RAM 子账号，仅授予 OSS 权限
ALIYUN_OSS_ACCESS_KEY_ID=你的AccessKeyId
ALIYUN_OSS_ACCESS_KEY_SECRET=你的AccessKeySecret

# OSS Bucket 名称（需先在控制台创建，见 deploy-aliyun.bat 说明）
ALIYUN_OSS_BUCKET=bangdream-museum

# 地域：选离用户近的国内节点，如 oss-cn-hangzhou / oss-cn-shanghai / oss-cn-guangzhou
ALIYUN_OSS_REGION=oss-cn-hangzhou

# 一般不用改，与 REGION 对应
ALIYUN_OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
